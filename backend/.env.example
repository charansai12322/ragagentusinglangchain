# Groq LLM Configuration
# Obtain your key at https://console.groq.com/keys
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Embedding Configuration (FastEmbed CPU-optimized ONNX)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["https://ragagentusinglangchain.vercel.app","http://localhost:5173","http://localhost:3000"]

# Document Ingestion Security & Limits
MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=100
PDF_DOWNLOAD_TIMEOUT_SECONDS=15

# Session & Concurrency Bounds
SESSION_TTL_MINUTES=60
MAX_SESSIONS=20
MAX_CONCURRENT_INGESTIONS=2
MAX_CONCURRENT_LLM_REQUESTS=3

# RAG & Chat Retrieval Tuning
RAG_TOP_K=4
MAX_CONTEXT_TOKENS=6000
MAX_CHAT_HISTORY_TURNS=5
LLM_TIMEOUT_SECONDS=30
